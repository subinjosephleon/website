# VISCOM 2027 Backend Environment Variables
# Rename this file to .env before running the server

# Server Configuration
PORT=3000

# Email Configuration (for contact & registration notifications)
# Use Gmail App Password (not your regular password)
# How to get Gmail App Password:
# 1. Go to myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" and create one for "Mail"
EMAIL_USER=viscom2027@tce.edu
EMAIL_PASS=your_gmail_app_password_here
EMAIL_RECIPIENT=viscom2027@tce.edu

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500
